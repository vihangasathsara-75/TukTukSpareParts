<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tuktuk.tuktukspareparts.SearchController">
    <children>
        <Label text="Search Parts">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
        <HBox spacing="10.0">
            <children>
                <Label minWidth="100.0" text="Keyword:" />
                <TextField fx:id="txtKeyword" promptText="search by name or brand" />
            </children>
        </HBox>
        <HBox spacing="10.0">
            <children>
                <Label minWidth="100.0" text="Category:" />
                <ComboBox fx:id="cmbCategory" promptText="All categories" />
            </children>
        </HBox>
        <HBox spacing="10.0">
            <children>
                <Label minWidth="100.0" text="Min Price:" />
                <TextField fx:id="txtMinPrice" promptText="e.g. 500" />
            </children>
        </HBox>
        <HBox spacing="10.0">
            <children>
                <Label minWidth="100.0" text="Max Price:" />
                <TextField fx:id="txtMaxPrice" promptText="e.g. 5000" />
            </children>
        </HBox>
        <HBox spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleSearch" text="Search" />
                <Button mnemonicParsing="false" onAction="#handleClear" text="Clear" />
            </children>
        </HBox>
        <TableView fx:id="searchResultsTable" prefHeight="300.0">
            <columns>
                <TableColumn fx:id="colCode" prefWidth="70.0" text="Code" />
                <TableColumn fx:id="colName" prefWidth="180.0" text="Name" />
                <TableColumn fx:id="colBrand" prefWidth="100.0" text="Brand" />
                <TableColumn fx:id="colCategory" prefWidth="100.0" text="Category" />
                <TableColumn fx:id="colPrice" prefWidth="80.0" text="Price" />
                <TableColumn fx:id="colQuantity" prefWidth="50.0" text="Qty" />
            </columns>
        </TableView>
        <Label fx:id="lblResults" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>