<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tuktuk.tuktukspareparts.DealerController">
    <children>
        <Label text="Dealer Selection">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
        <Button mnemonicParsing="false" onAction="#handleSelectDealers" text="Select 4 Random Dealers" />
        <TableView fx:id="dealerTable" prefHeight="300.0">
            <columns>
                <TableColumn fx:id="colCode" prefWidth="70.0" text="Code" />
                <TableColumn fx:id="colName" prefWidth="200.0" text="Name" />
                <TableColumn fx:id="colPhone" prefWidth="120.0" text="Phone" />
                <TableColumn fx:id="colLocation" prefWidth="150.0" text="Location" />
            </columns>
        </TableView>
        <Label fx:id="lblMessage" text="click the button to select 4 random dealers" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>