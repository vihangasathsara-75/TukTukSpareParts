<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.DatePicker?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tuktuk.tuktukspareparts.EditPartController">
    <children>
        <Label text="Edit Part">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
        <HBox spacing="10.0">
            <children>
                <Label minWidth="100.0" text="Part Code:" />
                <Label fx:id="lblCode" />
            </children>
        </HBox>
        <HBox spacing="10.0">
            <children>
                <Label minWidth="100.0" text="Name:" />
                <TextField fx:id="txtName" />
            </children>
        </HBox>
        <HBox spacing="10.0">
            <children>
                <Label minWidth="100.0" text="Brand:" />
                <TextField fx:id="txtBrand" />
            </children>
        </HBox>
        <HBox spacing="10.0">
            <children>
                <Label minWidth="100.0" text="Price:" />
                <TextField fx:id="txtPrice" />
            </children>
        </HBox>
        <HBox spacing="10.0">
            <children>
                <Label minWidth="100.0" text="Quantity:" />
                <TextField fx:id="txtQuantity" />
            </children>
        </HBox>
        <HBox spacing="10.0">
            <children>
                <Label minWidth="100.0" text="Category:" />
                <ComboBox fx:id="cmbCategory" />
            </children>
        </HBox>
        <HBox spacing="10.0">
            <children>
                <Label minWidth="100.0" text="Date:" />
                <DatePicker fx:id="datePicker"/>
            </children>
        </HBox>
        <HBox spacing="10.0">
            <children>
                <Label minWidth="100.0" text="Image File:" />
                <TextField fx:id="txtImageFile" />
            </children>
        </HBox>
        <Label fx:id="lblMessage" textFill="RED" />
        <HBox spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleSave" text="Save Changes" />
                <Button mnemonicParsing="false" onAction="#handleCancel" text="Cancel" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>